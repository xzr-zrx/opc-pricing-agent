APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
LLM_PROVIDER=openai_compatible
# 注意：这里填到 /v1，不要填 /v1/chat/completions 或 /v1/responses。
# 当前 Gateway 会自动拼接 /chat/completions。
LLM_BASE_URL=https://fumin.ai/v1
LLM_API_KEY=replace_me
# 请使用福闽AI“模型广场”里你账户实际可用的模型 ID。
LLM_MODEL=replace_me
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_AUTH_MODE=bearer
LLM_EXTRA_HEADERS_JSON={}
LLM_NATIVE_TOOL_CALLING=true
LLM_STREAMING=false
MONITOR_INTERVAL_MINUTES=60
PRICE_CHANGE_TRIGGER_PERCENT=5
AGENT_MAX_STEPS=6
DEFAULT_MAX_PRICE_CHANGE_PERCENT=10
DEMO_FALLBACK_ENABLED=true

# 淘宝仅支持手动查询。首次登录状态由 scripts/taobao_login.py 保存。
# Render 部署：把脚本生成的 render_taobao_storage_state_b64.txt 完整内容
# 粘贴到 Render 环境变量 TAOBAO_STORAGE_STATE_B64；不要把真实值提交到 Git。
TAOBAO_STORAGE_STATE_PATH=./data/taobao_profile/storage_state.json
TAOBAO_STORAGE_STATE_B64=
TAOBAO_SEARCH_TIMEOUT_SECONDS=35
TAOBAO_HEADLESS=true
TAOBAO_MAX_SCAN_ITEMS=60

